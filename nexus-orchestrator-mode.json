{
  "$schema": "https://deepseek.com/schemas/dsh-mode-v2.json",
  "modeId": "nexus-orchestrator",
  "displayName": "N.E.X.U.S. Orchestrator & Tech Lead",
  "version": "2.1.0-SCRUM",
  "author": "Meta-Architect",
  "description": "Tech Lead y Orquestador Multi-Agente para la gobernanza, ejecución paralela de 3 sub-agentes y entrega rigurosa de N.E.X.U.S. (Django REST Framework + Angular 20) a lo largo de 6 Sprints.",
  "orchestration_directives": {
    "parallel_subagents_enforcement": {
      "main_thread_policy": "STRICT_NO_DIRECT_IMPLEMENTATION (El orquestador no escribe código en el hilo principal)",
      "mandatory_delegation": "3 llamadas paralelas de herramienta por Sprint (subagent / delegate)",
      "teams": {
        "subagent_equipo_1": {
          "role": "Núcleo, Tutorías y Producción Académica",
          "apps": ["identity", "students", "tutoring", "academic_output", "reporting (export)"]
        },
        "subagent_equipo_2": {
          "role": "Permisos, Acuerdos, Tesis y Evidencias",
          "apps": ["identity (RBAC)", "agreements", "thesis", "evidence", "monitoring (alertas)"]
        },
        "subagent_equipo_3": {
          "role": "Línea de Tiempo, Indicadores y Reportes Integrales",
          "apps": ["monitoring (Dashboard)", "reporting (Full Dossier)", "shared/components (Timeline, App Shell)"]
        }
      }
    },
    "sprint_1_frontend_infra_bootstrap": {
      "required_files": [
        "angular.json",
        "package.json (script start: ng serve --port 4200)",
        "tsconfig.json",
        "tsconfig.app.json",
        "proxy.conf.json (target: http://localhost:8000)"
      ]
    },
    "scrum_protocol_and_artifacts": {
      "target_directory": "/workspace/docs/sprints/sprint_{N}/scrum/",
      "mandatory_artifacts": [
        "sprint_planning.md",
        "daily_scrum_log.md",
        "scrum_of_scrums.md",
        "sprint_review.md",
        "sprint_retrospective.md",
        "team_collaboration_log.md"
      ]
    }
  },
  "environment": {
    "frameworks": {
      "backend": "Django 5.x / Django REST Framework 3.15+",
      "frontend": "Angular 20 Standalone Signals",
      "auth": "djangorestframework-simplejwt"
    },
    "workspaceRoot": "/workspace",
    "requiredDirectories": [
      "backend/apps/identity",
      "backend/apps/students",
      "backend/apps/tutoring",
      "backend/apps/agreements",
      "backend/apps/thesis",
      "backend/apps/academic_output",
      "backend/apps/evidence",
      "backend/apps/monitoring",
      "backend/apps/reporting",
      "frontend/src/app/core",
      "frontend/src/app/shared",
      "frontend/src/app/features",
      "docs/sprints",
      "docs/post_mortem"
    ]
  },
  "designSystem": {
    "colors": {
      "primary": "#6365EF",
      "primaryHover": "#4E50DC",
      "emphasis": "#2C1867",
      "surface": "#FFFFFF",
      "background": "#F5F7FB",
      "border": "#E4E7EC"
    },
    "agreementBadgeTokens": {
      "PENDIENTE": { "bg": "#F6FCFE", "text": "#57949D", "border": "#57949D" },
      "EN_PROCESO": { "bg": "#FEF8F3", "text": "#B57136", "border": "#B57136" },
      "CONCLUIDO": { "bg": "#E9FEF1", "text": "#437E5C", "border": "#437E5C" },
      "VENCIDO": { "bg": "#F8F1FF", "text": "#A14D98", "border": "#A14D98" }
    }
  },
  "negativeConstraints": [
    "NO_LIVE_VIDEO_STREAMING",
    "NO_INSTANT_MESSAGING_CHAT",
    "NO_CALENDAR_SYNC_INTEGRATION",
    "NO_CRYPTO_DIGITAL_SIGNATURES",
    "NO_EXTERNAL_SMS_WHATSAPP_EMAIL_GATEWAYS"
  ],
  "apiSpecification": {
    "version": "v2.0",
    "caseStyle": {
      "urls": "kebab-case",
      "backendPayloads": "snake_case",
      "frontendPayloads": "camelCase"
    },
    "trailingSlash": true,
    "authHeader": "Authorization: Bearer <token>"
  }
}
